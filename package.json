{
  "name": "payroll-exercise",
  "private": true,
  "workspaces": [
    "client"
  ],
  "scripts": {
    "postinstall": "dotnet restore server/Payroll.slnx",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:fresh": "npm run db:reset && npm run dev",
    "dev:api": "dotnet watch --project server/Payroll.Api --no-hot-reload --non-interactive",
    "dev:web": "npm run dev -w client",
    "test": "npm run test:api && npm run test:web",
    "test:api": "dotnet test server/Payroll.slnx",
    "test:web": "npm test -w client",
    "db:reset": "node scripts/db-reset.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "10.0.6"
  }
}
